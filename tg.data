-- desliga a única inscrição dela
UPDATE inscricao_programa SET data_desligamento = CURRENT_DATE WHERE id_participante = 1;

-- confere: deveria ter virado id_status = 4 automaticamente
SELECT id_status FROM participante WHERE id_participante = 1;